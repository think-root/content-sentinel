# Server port for production
PORT=3000

# Debug delay (in milliseconds)
VITE_DEBUG_DELAY=0

# Backend services. The dashboard calls them through its own /proxy/ path,
# so the tokens stay on the server.
ALCHEMIST_URL=https://alchemist.example.com
ALCHEMIST_TOKEN=
MAESTRO_URL=https://maestro.example.com
MAESTRO_TOKEN=

# Cloudflare Access: only requests with a valid Access token for this
# application reach the proxy, which holds the tokens above.
# ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# ACCESS_AUD=

# Or, without Cloudflare: a login page with one user name and password for
# the whole dashboard (`npm start` and Docker). Use a long random password,
# and HTTPS in front if the server is reachable from the internet.
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASSWORD=

# With neither, `npm start` and Docker refuse to proxy unless this is set.
# Only do that when nobody else can reach the server.
# ALLOW_UNAUTHENTICATED_PROXY=true
